# Inlined into the build: set these before `npm run build`, not only at runtime.

# Canonical origin of this site. Every og:url and og:image is built from it.
NEXT_PUBLIC_SITE_URL=https://antitect.org

# Public API origin. The browser posts registrations here, so the API's
# MAIN_SITE_URL must equal NEXT_PUBLIC_SITE_URL exactly or CORS blocks them.
NEXT_PUBLIC_API_URL=https://antitect-crm.onrender.com

# Optional. A private-network address for server-side reads, when the host has one.
INTERNAL_API_URL=

# No secrets belong in this app. If something seems to need one, it belongs in the API.
