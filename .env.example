# Inlined into the build: set these before `npm run build`, not only at runtime.

# Canonical origin of this site. Every og:url and og:image is built from it.
NEXT_PUBLIC_SITE_URL=https://antitect.org

# Public API origin. The browser posts registrations here, so the API's
# MAIN_SITE_URL must equal NEXT_PUBLIC_SITE_URL exactly or CORS blocks them.
NEXT_PUBLIC_API_URL=https://antitect-crm.onrender.com

# Optional. A private-network address for server-side reads, when the host has one.
INTERNAL_API_URL=

# --- Signed-in areas: /learn for learners, /teach for tutors ---

# The cookies the API reads each session out of. Set these only if the API is
# configured to call them something other than the defaults.
LEARNER_API_COOKIE=
TUTOR_API_COOKIE=

# Every signed-in request reaches the API from this server, so the API would see
# one address for a whole cohort and rate-limit them as one person. With this
# secret set — and matching the API's — the site sends the visitor's own
# address alongside it, and the API can count per person again. Without it the
# site sends neither header, and the API ignores what it cannot verify.
#
# It is the only secret this app holds, it is never sent to a browser, and it
# buys nothing on its own. Anything that can spend money or send a message
# belongs in the API.
LEARNER_PROXY_SECRET=
